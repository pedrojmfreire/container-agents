#!/bin/bash
set -e

# Author:  Pedro Freire  http://www.pedrofreire.com
# License: Apache 2.0    https://www.apache.org/licenses/LICENSE-2.0.txt


# User-defined script configuration
# NOTE: If ~/dev-env.sh exists, its values override what's defined here
# ===========================================================================

# In these host directories, AI agents run with no restrictions
PROJECT_DIRS=(
	"$HOME/Documents/Software"
)

# Base directory for container settings
# Note: This should be an absolute path! Replace before running!
CONTAINERS_DIR="./src/containers"

LOCALHOST_DNS_ALIAS=host.container.internal
LOCALHOST_IP_ALIAS=203.0.113.113
# https://github.com/apple/container/blob/main/docs/host-integration.md#access-a-host-service-from-a-container
# https://github.com/apple/container/blob/main/docs/command-reference.md#container-system-dns-create

VM_USER=user
VM_HOST=vm.local
VM_PORTS=(
	22    # SSH / SFTP
	80    # HTTP
	443   # HTTPS
)

# Base directory for user-level AI skills
# BETA: this shares only the directory, doesn't change the format
# Set to empty to disable this feature
AI_SKILLS_DIR=
	# Disabled
	# Good starting point to enable: "$HOME/.agents/skills"


# Override local configuration with ~/dev-env.sh
# ===========================================================================

if [[ -f "$HOME/dev-env.sh" ]]
then
	. "$HOME/dev-env.sh"

	((${#DEV_ENV_PROJECT_DIRS[@]}))  &&  PROJECT_DIRS=("${DEV_ENV_PROJECT_DIRS[@]}")

	CONTAINERS_DIR="${DEV_ENV_CONTAINERS_DIR:-$CONTAINERS_DIR}"

	LOCALHOST_DNS_ALIAS="${DEV_ENV_LOCALHOST_DNS_ALIAS:-$LOCALHOST_DNS_ALIAS}"
	LOCALHOST_IP_ALIAS="${DEV_ENV_LOCALHOST_IP_ALIAS:-$LOCALHOST_IP_ALIAS}"

	VM_USER="${DEV_ENV_VM_USER:-$VM_USER}"
	VM_HOST="${DEV_ENV_VM_HOST:-$VM_HOST}"
	((${#DEV_ENV_VM_PORTS[@]}))  &&  VM_PORTS=("${DEV_ENV_VM_PORTS[@]}")

	AI_SKILLS_DIR="${DEV_ENV_AI_SKILLS_DIR:-$AI_SKILLS_DIR}"
fi


# Constants
# ===========================================================================

AGENT_USER="$USER"
AGENT_HOME="$HOME"

ALLOW_TRIPLE_DASH_OPTS_ONLY=true
# If true, all options are "---long" and everything else is passed to the agent.
# This makes "---" redundant.
# If false, "-short" and "--long" options are available, requiring "-" before
# options to be passed to the agent.

SSH_SOCKET="/tmp/agent-start-vm-tunnel.$UID.sock"
DNS_ALIAS_LIST="/tmp/agent-start-dns-alias.$UID.txt"


# Parse the command-line arguments
# ===========================================================================

cli_args=()
is_single_project=true
has_ssh_access=false
has_vm_access=false
has_host_localhost_access=false
has_no_mapping=false

dot=.
aka=" "
$ALLOW_TRIPLE_DASH_OPTS_ONLY  &&  dot=-
$ALLOW_TRIPLE_DASH_OPTS_ONLY  &&  aka=


while [[ $# -gt 0 ]]
do
	case ".$1" in
		".---agent=claude"|".---agent=claude-code"|"${dot}claude"|"${dot}claude-code")
			agent_container=agent-claude
			agent_env=(                      \
				--env DISABLE_UPDATES=1      \
				--env DISABLE_AUTOUPDATER=1  \
				--env ANTHROPIC_API_KEY      \
			)
			agent_env_unsafe=()
			agent_exec=claude
			agent_args=()
			agent_args_unsafe=(                      \
				--permission-mode bypassPermissions  \
				--dangerously-skip-permissions       \
			)
			agent_home_paths=(
				"$HOME/.claude"               "$CONTAINERS_DIR/claude/!claude"
				"$HOME/.claude.json"          "$CONTAINERS_DIR/claude/!claude.json"
				"$HOME/.config/ccstatusline"  "$CONTAINERS_DIR/claude/!config/ccstatusline"
			)
			;;
		".---agent=codex"|".---agent=chat-gpt"|"${dot}codex"|"${dot}chatgpt")
			agent_container=agent-codex
			agent_env=()
			agent_env_unsafe=()
			agent_exec=codex
			agent_args=(                                    \
				--config check_for_update_on_startup=false  \
			)
			agent_args_unsafe=(                             \
				--sandbox danger-full-access                \
				--dangerously-bypass-approvals-and-sandbox  \
			)
			agent_home_paths=(
				"$HOME/.codex"  "$CONTAINERS_DIR/codex/!codex"
			)
			;;
		".---agent=antigravity"|".---agent=agy"|"${dot}antigravity"|"${dot}agy")
			agent_container=agent-antigravity
			agent_env=(--env AGY_CLI_DISABLE_AUTO_UPDATE=true)
			agent_env_unsafe=()
			agent_exec=agy
			agent_args=()
			agent_args_unsafe=(--dangerously-skip-permissions)
			agent_home_paths=(
				"$HOME/.gemini"  "$CONTAINERS_DIR/antigravity/!gemini"
			)
			;;
		".---agent=gemini"|"${dot}gemini")
			agent_container=agent-gemini
			agent_env=()
			agent_env_unsafe=()
			agent_exec=gemini
			agent_args=()
			agent_args_unsafe=(--yolo)
			agent_home_paths=(
				"$HOME/.gemini"  "$CONTAINERS_DIR/gemini/!gemini"
			)
			;;
		".---agent=vibe"|".---agent=mistral"|".---agent=mistral-vibe"|"${dot}vibe"|"${dot}mistral"|"${dot}mistral-vibe")
			agent_container=agent-vibe
			agent_env=(                                \
				--env VIBE_ENABLE_AUTO_UPDATE=false    \
				--env VIBE_ENABLE_UPDATE_CHECKS=false  \
				--env MISTRAL_API_KEY                  \
			)
			agent_env_unsafe=()
			agent_exec=vibe
			agent_args=()
			agent_args_unsafe=(--yolo)
			agent_home_paths=(
				"$HOME/.vibe"  "$CONTAINERS_DIR/vibe/!vibe"
			)
			;;
		".---agent=opencode"|".---agent=open-code"|".---agent=oc"|"${dot}opencode"|"${dot}open-code"|"${dot}oc")
			agent_container=agent-opencode
			agent_env=(--env OPENCODE_DISABLE_AUTOUPDATE=true)
			agent_env_unsafe=(--env OPENCODE_PERMISSION='{"*":"allow"}')
			agent_exec=opencode
			agent_args=()
			agent_args_unsafe=(--auto)
			agent_home_paths=(
				"$HOME/.cache/opencode"        "$CONTAINERS_DIR/opencode/!cache/opencode"
				"$HOME/.config/opencode"       "$CONTAINERS_DIR/opencode/!config/opencode"
				"$HOME/.local/state/opencode"  "$CONTAINERS_DIR/opencode/!local/state/opencode"
				"$HOME/.local/share/opencode"  "$CONTAINERS_DIR/opencode/!local/share/opencode"
				"$HOME/.local/share/opentui"   "$CONTAINERS_DIR/opencode/!local/share/opentui"
			)
			;;
		".---agent=n8n"|"${dot}n8n")
			agent_container=agent-n8n
			agent_env=(--env N8N_SECURE_COOKIE=false)
			agent_env_unsafe=()
			agent_exec=n8n
			agent_args=()
			agent_args_unsafe=()
			agent_home_paths=(
				"$HOME/.n8n"  "$CONTAINERS_DIR/n8n/!n8n"
			)
			has_no_mapping=true
			;;
		".---help"|"${dot}-h"|"${dot}--help")
			echo
			echo "Usage:"
			echo "    $(basename "$0") [<options>, ...]"
			echo
			echo "Options:"
			echo "  ---agent=<agent>  Select the agent to use (mandatory). ${aka:+"a.k.a. just <agent>."}"
			echo "                    Supported agents: claude, codex, antigravity, agy, gemini, vibe, opencode, n8n."
			echo "  ---all            Map all project dirs (\$PROJECT_DIRS) to allow the agent to work across"
			echo "                    projects. ${aka:+"a.k.a. -a, --all."}"
			echo "  ---sh             Run the container shell, not the agent itself."
			echo "                    Must be defined after ---agent. ${aka:+"a.k.a. -s, --sh."}"
			echo "  ---ssh            Map ~/.ssh/* files to allow the agent to access to servers/Virtual Machines. ${aka:+"a.k.a. --sh."}"
			echo "                    Expects to find: ~/.ssh/ssh-agent-<agent>.pem, ~/.ssh/ssh-agent-<agent>.pem.pub,"
			echo "                    ~/.ssh/config-agent-<agent>.pem and ~/.ssh/known_hosts_agents."
			echo "  ---local          Create a container DNS '$LOCALHOST_DNS_ALIAS' that maps to the host's localhost,"
			echo "                    via $LOCALHOST_IP_ALIAS. Required to access Ollama, LM Studio, MTPLX models,"
			echo "                    VMs, or other services running on the host. This DNS entry is persistent across"
			echo "                    all future invocations of agents, until a reboot. Environment vars"
			echo "                    LOCALHOST_DNS_ALIAS and LOCALHOST_IP_ALIAS are passed to the agent for reuse."
			echo "                    This is incompatible with iCloud Private Relay. ${aka:+"a.k.a. -l, --local."}"
			echo "  ---local-del      Delete DNS entry created by ---local, and exit. ${aka:+"a.k.a. -l-, --local-del."}"
			echo "  ---vm             Setup SSH tunnels to allow the agent to access a host VM ('$VM_USER@$VM_HOST')"
			echo "                    using Shared Network. Not required for Bridged Network."
			echo "                    This SSH tunnel is persistent across all future invocations of agents, until"
			echo "                    the VM shuts down. Implies ---local."
			echo "                    This is incompatible with services running in the host in the same ports"
			echo "                    (${VM_PORTS[*]}). ${aka:+"a.k.a. --vm."}"
			echo "  ---vm-del         Close the SSH tunnel created by ---vm, and exit. Does not do a ---local-del. ${aka:+"a.k.a. --vm-del."}"
			echo "  ---connect        Combined ---ssh, ---local and ---vm. ${aka:+"a.k.a. -c, --connect."}"
			echo "  ---link           Link '$CONTAINERS_DIR/<agent>/!*'"
			echo "                    to ~/.config, ~/.local, etc. and exit. ${aka:+"a.k.a. --link."}"
			echo "  ---unlink         Unlink '$CONTAINERS_DIR/<agent>/!*'"
			echo "                    from ~/.config, ~/.local, etc. and exit. ${aka:+"a.k.a. --unlink."}"
			echo "  ---safe           Do not pass any '--dangerously-skip-permissions'-type options to the agent."
			echo "                    Must be defined after ---agent. ${aka:+"a.k.a. --safe."}"
			echo "  ---raw            Do not pass any implicit options or environment to the agent at all."
			echo "                    Must be defined after ---agent. ${aka:+"a.k.a. -r, --raw."}"
			echo "  ---help           This help. ${aka:+"a.k.a. -h, --help."}"
			echo
			echo "All ---local, ---vm also create DNS aliases inside the container, that match host /etc/hosts DNS"
			echo "aliases pointing to 127.0.0.1 or the VM's '$VM_HOST' IP. All DNS aliases inside the container will"
			echo "point to $LOCALHOST_IP_ALIAS. This ensures they match functionality on the host and container."
			echo
			echo "Pass options to the agent:"
			echo "  --- <agent-options>  Stop processing the next options and pass them to the agent. ${aka:+"a.k.a. -."}"
			echo
			exit 0
			;;
		".---all"|"${dot}-a"|"${dot}--all")
			is_single_project=false
			;;
		".---sh"|"${dot}-s"|"${dot}--sh")
			agent_exec=bash
			agent_args=()
			agent_args_unsafe=()
			;;
		".---ssh"|"${dot}--ssh")
			has_ssh_access=true
			;;
		".---local"|"${dot}-l"|"${dot}--local")
			has_host_localhost_access=true
			;;
		".---local-del"|"${dot}-l-"|"${dot}--local-del")
			echo "Deleting DNS record '$LOCALHOST_DNS_ALIAS' (requires sudo)"
			sudo container system dns delete "$LOCALHOST_DNS_ALIAS"
			echo
			echo "Restarting container system"
			container system stop
			container system start
			exit 0
			;;
		".---vm"|"${dot}--vm")
			has_vm_access=true
			has_host_localhost_access=true
			;;
		".---vm-"|".---vm-del"|".---vm-close"|"${dot}--vm-"|"${dot}--vm-del"|"${dot}--vm-close")
			# TODO: Review using "container system dns ..." no earlier than 2027, to evaluate it against copying /etc/hosts
			# This is failing (2026-08), likely due to bugs:
			# https://github.com/apple/container/issues/817
			# https://github.com/apple/container/issues/1794
			#
			#echo "Deleting DNS aliases to localhost/VM (requires sudo)"
			if [ -f "$DNS_ALIAS_LIST" ]
			then
			#	while read -r name; do
			#		sudo container system dns delete $name  ||  true
			#	done < "$DNS_ALIAS_LIST"
				rm "$DNS_ALIAS_LIST"
			fi
			#echo
			echo "Testing for existing tunnel to VM '$VM_HOST' (requires sudo)"
			if sudo ssh -S "$SSH_SOCKET" -O check "${VM_USER}@${VM_HOST}" 2>/dev/null
			then
				echo
				echo "Closing tunnel to VM '$VM_HOST' (requires sudo)"
				sudo ssh -S "$SSH_SOCKET" -O exit "${VM_USER}@${VM_HOST}"
			fi
			if [ -f "$SSH_SOCKET" ]
			then
				rm "$SSH_SOCKET"
			fi
			exit 0
			;;
		".---connect"|".---combined"|"${dot}-c"|"${dot}--connect"|"${dot}--combined")
			has_ssh_access=true
			has_vm_access=true
			has_host_localhost_access=true
			;;
		".---link")
			# Soft-link all configuration directories to $HOME
			for ((i=0; i<${#agent_home_paths[@]}; i+=2))
			do
				home_path="${agent_home_paths[i]}"
				container_path="${agent_home_paths[i+1]}"

				if [[ -e "$container_path" && ! -e "$home_path" ]]
				then
					ln -s "$container_path" "$home_path"
					echo "$home_path -> $container_path"
				else
					echo "$home_path already exists; skipping"
				fi
			done
			exit 0
			;;
		".---unlink"|".---link-del")
			# Remove all soft links of all configuration directories in $HOME
			for ((i=0; i<${#agent_home_paths[@]}; i+=2))
			do
				home_path="${agent_home_paths[i]}"
				container_path="${agent_home_paths[i+1]}"

				if [[ -L "$home_path" && "$home_path" -ef "$container_path" ]]
				then
					rm "$home_path"
					echo "$home_path removed"
				else
					echo "$home_path missing or not a link to $container_path; skipping"
				fi
			done
			exit 0
			;;
		".---safe"|"${dot}--safe")
			agent_env_unsafe=()
			agent_args_unsafe=()
			;;
		".---raw"|"${dot}-r"|"${dot}--raw")
			agent_env=()
			agent_env_unsafe=()
			agent_args=()
			agent_args_unsafe=()
			;;
		".---"|"${dot}-")
			shift
			cli_args+=("$@")
			break
			;;
		*)
			if $ALLOW_TRIPLE_DASH_OPTS_ONLY
			then
				cli_args+=("$1")
			else
				echo "Missing or unknown argument ('$1'). Use ---help."
				exit 1
			fi
			;;
	esac
	shift
done


# Determine current woking directory (WORKSPACE)
# ===========================================================================

WORKSPACE="$(pwd)"

if [ ! $has_no_mapping ]
then
	if [ "$WORKSPACE" == "$HOME" ] || [ "$WORKSPACE" == "$HOME/Documents" ]
	then
		echo
		echo "You're running me from ~ or ~/Documents."
		echo "All of your documents will be shared with the agent."
		echo "Proceed? [N]"
		read -r confirm
		if [ "$confirm" != "Y" ]  &&  [ "$confirm" != "y" ]
		then
			exit 1
		fi
	fi
fi


# Check if WORKSPACE is one of the white-listed directories for unsafe agents
# ===========================================================================

is_whitelisted=false
if [ ! $has_no_mapping ]
then
	for whitelist_dir in "${PROJECT_DIRS[@]}"
	do
		if [[ "$WORKSPACE" == "$whitelist_dir" || "$WORKSPACE" == "$whitelist_dir/"* ]]
		then
			is_whitelisted=true
			agent_env+=("${agent_env_unsafe[@]}")
			agent_args+=("${agent_args_unsafe[@]}")
			break
		fi
	done
fi


# Start Apple Container system
# ===========================================================================

if ! container system status &>/dev/null
then
	container system start
fi


# Define the data mount volumes and working dir for the AI agent
# ===========================================================================

CONTAINER_WORKSPACE="$AGENT_HOME${WORKSPACE#"$HOME"}"

if $has_no_mapping || ! $is_whitelisted
then

	volumes=(--volume "$WORKSPACE:$AGENT_HOME/workspace")
	workdir=$AGENT_HOME/workspace

elif $is_single_project
then

	volumes=(--volume "$WORKSPACE:$CONTAINER_WORKSPACE")
	workdir="$CONTAINER_WORKSPACE"

else  # ! $is_single_project

	# With all projects mounted, use a similar directory structure,
	# so that these cross-references work:
	#	~/Documents/...
	#	../../another_project/...

	volumes=()
	for whitelist_dir in "${PROJECT_DIRS[@]}"
	do
		container_dir="$AGENT_HOME${whitelist_dir#"$HOME"}"
		volumes+=(--volume "$whitelist_dir:$container_dir")
	done
	workdir="$CONTAINER_WORKSPACE"

fi


# Start the AI agent's local (VM) domains
# ===========================================================================
if $has_vm_access
then
	# TODO: Review using "container system dns ..." no earlier than 2027, to evaluate it against copying /etc/hosts
	# This is failing (2026-08), likely due to bugs:
	# https://github.com/apple/container/issues/817
	# https://github.com/apple/container/issues/1794
	#
	#echo "Creating DNS aliases to localhost/VM (requires sudo)"
	#if [ -f "$DNS_ALIAS_LIST" ]
	#then
	#	echo "Aliases already created"
	#else
	#	VM_IP=$(awk "\$2 == \"$VM_HOST\" {print \$1}" /etc/hosts)
	#	awk "{ sub(/#.*/, \"\"); if (\$1 == \"127.0.0.1\" || \$1 == \"$VM_IP\") for (i=2;i<=NF;i++) print \$i }" /etc/hosts \
	#		| grep -vE '^(localhost|localhost\.localdomain|broadcasthost)$' > "$DNS_ALIAS_LIST"
	#	while read -r name; do
	#		sudo container system dns create $name --localhost $LOCALHOST_IP_ALIAS
	#	done < "$DNS_ALIAS_LIST"
	#fi
	#echo
	echo "Testing for existing tunnel to VM '$VM_HOST' (requires sudo)"
	if ! sudo ssh -S "$SSH_SOCKET" -O check "${VM_USER}@${VM_HOST}" 2>/dev/null
	then
		port_links=()
		for port in "${VM_PORTS[@]}"
		do
			port_links+=(-L 127.0.0.1:"${port}":127.0.0.1:"${port}")
		done
		echo
		echo "Establishing tunnel to VM '$VM_HOST' (requires sudo)"
		sudo ssh -f -N                    \
			-o ControlMaster=yes          \
			-o ControlPath="$SSH_SOCKET"  \
			-o ControlPersist=yes         \
			-o ExitOnForwardFailure=yes   \
			-o ServerAliveInterval=30     \
			-o ServerAliveCountMax=3      \
			"${port_links[@]}"            \
			"${VM_USER}@${VM_HOST}"
	fi
fi


# Start the DNS records for accessing the host's localhost inside the container
# ===========================================================================
if $has_host_localhost_access
then
	echo "Recreating DNS record '$LOCALHOST_DNS_ALIAS' (requires sudo)"
	sudo container system dns delete "$LOCALHOST_DNS_ALIAS"  >/dev/null 2>&1  ||  true
	sudo container system dns create "$LOCALHOST_DNS_ALIAS" --localhost "$LOCALHOST_IP_ALIAS"
fi


# Prepare the hosts alias file to be sent to the container
# ===========================================================================
if $has_vm_access || $has_host_localhost_access
then
	if [ ! -f "$DNS_ALIAS_LIST" ]
	then
		VM_IP=$(awk "\$2 == \"$VM_HOST\" {print \$1}" /etc/hosts)
		awk "{ sub(/#.*/, \"\"); if (\$1 == \"127.0.0.1\" || \$1 == \"$VM_IP\") for (i=2;i<=NF;i++) print \$i }" /etc/hosts \
			| grep -vE "^(localhost|localhost\.localdomain|broadcasthost|$LOCALHOST_DNS_ALIAS)\$" > "$DNS_ALIAS_LIST"
	fi
fi
if [ -f "$DNS_ALIAS_LIST" ]
then
	volumes+=(--volume "$DNS_ALIAS_LIST:/etc/host-aliases.txt")
fi


# Start the AI agent's container
# ===========================================================================

tty_args=(-i)
[[ -t 0  &&  -t 1 ]]  &&  tty_args+=(-t)

case $agent_container in

	"agent-claude")
		if [ -n "$AI_SKILLS_DIR" ]
		then
			agent_container_skills_dir="$CONTAINERS_DIR/claude/!claude/skills"
			if [[ ! -d "$agent_container_skills_dir" || -z "$(ls -A "$agent_container_skills_dir" 2>/dev/null)" ]]
			then
				volumes+=( --volume "$AI_SKILLS_DIR:$AGENT_HOME/.claude/skills" )
			fi
		fi
		if $has_ssh_access
		then
			volumes+=(
				--volume "$HOME/.ssh/ssh-agent-claude.pem:$AGENT_HOME/.ssh/ssh-agent-claude.pem:ro"
				--volume "$HOME/.ssh/ssh-agent-claude.pem.pub:$AGENT_HOME/.ssh/ssh-agent-claude.pem.pub:ro"
				--volume "$HOME/.ssh/config-agent-claude:$AGENT_HOME/.ssh/config:ro"
				--volume "$HOME/.ssh/known_hosts_agents:$AGENT_HOME/.ssh/known_hosts:ro"
				)
		fi
		exec container run "${tty_args[@]}" --rm                                     \
			--cpus 2 --memory 3G                                                     \
			--progress none                                                          \
			"${volumes[@]}"                                                          \
			--volume "$CONTAINERS_DIR/claude/!claude:$AGENT_HOME/.claude"            \
			--volume "$CONTAINERS_DIR/claude/!claude.json:$AGENT_HOME/.claude.json"  \
			--volume "$CONTAINERS_DIR/claude/!config:$AGENT_HOME/.config"            \
			--workdir "$workdir"                                                     \
			--env LOCALHOST_DNS_ALIAS="$LOCALHOST_DNS_ALIAS"                         \
			--env LOCALHOST_IP_ALIAS="$LOCALHOST_IP_ALIAS"                           \
			--env COLORTERM                                                          \
			--env TERM                                                               \
			"${agent_env[@]}"                                                        \
			"$agent_container" "$agent_exec" "${agent_args[@]}" "${cli_args[@]}"
		;;

	"agent-codex")
		if [ -n "$AI_SKILLS_DIR" ]
		then
			volumes+=( --volume "$AI_SKILLS_DIR:$AGENT_HOME/.agents/skills" )
		fi
		if $has_ssh_access
		then
			volumes+=(
				--volume "$HOME/.ssh/ssh-agent-codex.pem:$AGENT_HOME/.ssh/ssh-agent-codex.pem:ro"
				--volume "$HOME/.ssh/ssh-agent-codex.pem.pub:$AGENT_HOME/.ssh/ssh-agent-codex.pem.pub:ro"
				--volume "$HOME/.ssh/config-agent-codex:$AGENT_HOME/.ssh/config:ro"
				--volume "$HOME/.ssh/known_hosts_agents:$AGENT_HOME/.ssh/known_hosts:ro"
				)
		fi
		exec container run "${tty_args[@]}" --rm                        \
			--cpus 2 --memory 2G                                        \
			--progress none                                             \
			"${volumes[@]}"                                             \
			--volume "$CONTAINERS_DIR/codex/!codex:$AGENT_HOME/.codex"  \
			--workdir "$workdir"                                        \
			--env LOCALHOST_DNS_ALIAS="$LOCALHOST_DNS_ALIAS"            \
			--env LOCALHOST_IP_ALIAS="$LOCALHOST_IP_ALIAS"              \
			--env COLORTERM                                             \
			--env TERM                                                  \
			"${agent_env[@]}"                                           \
			"$agent_container" "$agent_exec" "${agent_args[@]}" "${cli_args[@]}"
		;;

	"agent-antigravity")
